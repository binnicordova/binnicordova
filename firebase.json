{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|css|js|json|woff2|ttf|svg|png|jpg|jpeg|gif|webp)",
        "headers": [
          {
            "key": "Content-Encoding",
            "value": "br"
          },
          {
            "key": "Content-Encoding",
            "value": "gzip"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Link",
            "value": "</sitemap.xml>; rel=\"sitemap\", </llms.txt>; rel=\"describedby\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Link",
            "value": "</sitemap.xml>; rel=\"sitemap\", </llms.txt>; rel=\"describedby\""
          }
        ]
      },
      {
        "source": "**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
