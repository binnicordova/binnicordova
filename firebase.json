{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Link",
            "value": "</sitemap.xml>; rel=\"sitemap\", </llms.txt>; rel=\"describedby\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Link",
            "value": "</sitemap.xml>; rel=\"sitemap\", </llms.txt>; rel=\"describedby\""
          }
        ]
      },
      {
        "source": "**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/{llms.txt,index.md,robots.txt,sitemap.xml}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/Binni_Cordova_Resume.pdf",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=604800"
          },
          {
            "key": "X-Robots-Tag",
            "value": "index, follow, max-snippet:-1"
          }
        ]
      }
    ]
  }
}
